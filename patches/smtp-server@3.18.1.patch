                     tnx: 'send',
@@ -406,7 +416,13 @@ class SMTPConnection extends EventEmitter {
      */
     close() {
         if (!this._socket.destroyed && this._socket.writable) {
-            this._socket.end();
+            // NOTE(pbhh.net local patch): same race as send() -- the flags lag the handle.
+            // Without this, fixing the write above would only move the crash here.
+            try {
+                this._socket.end();
+            } catch {
+                // The peer is already gone; there is nothing left to shut down.
+            }
         }
 
         this._server.connections.delete(this);
