@@ -384,7 +384,17 @@ class SMTPConnection extends EventEmitter {
         }
 
         if (this._socket && !this._socket.destroyed && this._socket.readyState === 'open') {
-            this._socket.write(payload + '\r\n');
+            // NOTE(pbhh.net local patch): Bun throws ERR_SOCKET_CLOSED synchronously from
